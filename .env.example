# ============================================================
# [인덕과학기술고등학교] 파이썬 저지 Supabase 환경변수 설정 가이드
# Supabase 대시보드 (https://supabase.com/dashboard)
# -> 해당 프로젝트 선택 -> Project Settings (톱니바퀴) -> API
# ============================================================

# 1. Project URL (예: https://abcdefghijklm.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here

# 2. Project API Keys - anon (public) 또는 service_role 키
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 교사 대시보드 보안 비밀번호 (기본: induk2026)
TEACHER_PIN=induk2026

